# Copy to .env and fill in. Never commit .env.
PORT=4000
# Local MongoDB or a free MongoDB Atlas cluster, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/teamup
MONGODB_URI=mongodb://127.0.0.1:27017/teamup
# Optional but recommended: a GitHub personal access token (no scopes needed).
# Without it GitHub allows 60 requests/hour; with it, 5,000.
GITHUB_TOKEN=
# Comma-separated list of frontend origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
